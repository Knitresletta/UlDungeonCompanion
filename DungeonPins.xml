<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<Frame name="UlDCDungeonPinTemplate" enableMouseMotion="true" enableMouseClicks="true" mixin="UlDCDungeonPinMixin" virtual="true">
		<Size x="24" y="24"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Texture" atlas="Dungeon" useAtlasSize="true">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture parentKey="Highlight" atlas="Dungeon" useAtlasSize="true" alphaMode="ADD" alpha="0.4">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
	</Frame>
</Ui>
